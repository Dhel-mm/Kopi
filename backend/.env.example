NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Generate a private secret. Never commit real values.
JWT_SECRET=replace-me-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@kopicalamba.com
# Used ONLY when creating the first administrator. Change existing passwords
# through the website; editing this variable does not reset an existing user.
ADMIN_PASSWORD=replace-me-with-a-unique-long-password
# Optional absolute path on a persistent disk, outside the public web folders.
# DATABASE_PATH=C:/KopiData/kopi.db
# Behind a reverse proxy: "loopback" (proxy on the same machine), a number of
# proxy hops, or "true" on a hosting platform such as Render.
# TRUST_PROXY=loopback

# Optional school demo: one-time stock top-up and a new Customer account.
# Leave disabled for real shop use. Never commit the demo password.
DEMO_SETUP_ENABLED=false
# DEMO_CUSTOMER_EMAIL=customer.demo@example.com
# DEMO_CUSTOMER_PASSWORD=choose-a-unique-password-at-least-12-characters

# Email verification for new customer accounts (see EMAIL-VERIFICATION.md).
# Without these, local development prints the 6-digit code in the server window.
# Gmail: use a Google "App password" (16 letters), never your normal password.
# SMTP_USER=yourshop@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM_NAME=Kopi; Calamba
